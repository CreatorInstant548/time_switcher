# Fins de ligne : LF partout (A4)
*            text=auto eol=lf
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.sln        text eol=crlf

# Binaires
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.otf  binary

# Générés : repliés dans les diffs de GitHub
Cargo.lock      linguist-generated=true
uv.lock         linguist-generated=true
pnpm-lock.yaml  linguist-generated=true

