#!/bin/sh
# pre-commit : refus de tout commit sur main (SEC0-13), garde des gros fichiers (SEC0-11),
# gitleaks sur l'index, sur toutes les branches (SEC0-08).
# spec: carnet architecture-securite.md SEC0-08, SEC0-11, SEC0-13
. "$(dirname "$0")/common.sh"

# 1. Aucun commit sur main, sans exception ni variable de contournement.
[ "$(current_branch)" = "main" ] && fail "aucun commit sur main (SEC0-13) : travaillez sur une branche claude/<sujet>, puis une PR."

# 2. Gros fichiers et binaires hors LFS (SEC0-11).
MAX=5242880        # 5 Mo
FIXTURE_MAX=262144 # 256 Ko, exception **/tests/fixtures/**
TAB=$(printf '\t')
EXT='glb gltf png jpg ogg wav mp3 otf ttf onnx gguf pt safetensors parquet sqlite db blend psd fbx zip 7z'
errors=$(
  git -c core.quotepath=off diff --cached --raw --no-renames --diff-filter=ACMRT --no-abbrev |
  while IFS= read -r line; do
    meta=${line%%"$TAB"*}; path=${line#*"$TAB"}
    set -- $meta
    mode=$2; sha=$4
    [ "$mode" = "160000" ] && continue   # sous-module
    case $path in \"*) echo "nom de fichier inhabituel, refusé par prudence : $path"; continue ;; esac
    size=$(git cat-file -s "$sha")
    [ "$size" -gt "$MAX" ] && { echo "$path : $size octets (> 5 Mo)"; continue; }
    lower=$(printf '%s' "$path" | tr 'A-Z' 'a-z')
    ext=${lower##*.}
    [ "$ext" = "$lower" ] && continue
    case " $EXT " in *" $ext "*) ;; *) continue ;; esac
    # Pointeur LFS réel : attribut filter=lfs et contenu « version https://git-lfs... ».
    if git check-attr filter -- "$path" | grep -q ': filter: lfs$' && [ "$size" -lt 1024 ] &&
       git cat-file -p "$sha" | head -n 1 | grep -q '^version https://git-lfs.github.com/spec/'; then
      continue
    fi
    case "/$path" in
      */tests/fixtures/*) [ "$size" -le "$FIXTURE_MAX" ] && continue
                          echo "$path : fixture de $size octets (> 256 Ko)"; continue ;;
    esac
    echo "$path : extension .$ext interdite hors LFS (artefacts dans TS_CACHE, assets en LFS)"
  done
)
[ -n "$errors" ] && fail "fichiers refusés (SEC0-11) :
$errors"

# 3. Secrets dans l'index.
gitleaks_checked
gitleaks_run --pre-commit --staged ||
  fail "gitleaks a trouvé un secret probable dans l'index (SEC0-08). Retirez-le ; s'il est réel, il est à remplacer."
exit 0
