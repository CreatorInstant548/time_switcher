#!/bin/sh
# pre-push : refus de forcer vers une autre branche que main, de supprimer main ou pilotage ;
# gitleaks sur la plage poussée, main comprise (SEC0-08).
# La poussée directe et la poussée forcée vers main du distant origin ne sont plus refusées ici :
# le ruleset main (26213563) de GitHub les refuse pour tout le monde, sans contournement (AS-31,
# T3e-1). Vers le main de tout autre distant (nom ou URL), la poussée reste refusée.
# spec: carnet architecture-securite.md SEC0-08, SEC0-13
. "$(dirname "$0")/common.sh"
remote=$1
ZERO=0000000000000000000000000000000000000000
gitleaks_checked

while read -r local_ref local_sha remote_ref remote_sha; do
  dest=$(printf '%s' "$remote_ref" | tr 'A-Z' 'a-z')
  [ "$dest" = "refs/heads/main" ] && [ "$remote" != "origin" ] &&
    fail "poussée vers main permise seulement vers le distant origin, que garde le ruleset de GitHub (SEC0-13, AS-31)."
  # Main, MAIN : hors du ruleset, et confondus avec main dans un système de fichiers insensible à la casse.
  [ "$dest" = "refs/heads/main" ] && [ "$remote_ref" != "refs/heads/main" ] &&
    fail "variante de casse de main ($remote_ref) interdite : main s'écrit en minuscules (SEC0-13)."
  if [ "$local_sha" = "$ZERO" ]; then
    [ "$dest" = "refs/heads/main" ] && fail "suppression de la branche main interdite (SEC0-13)."
    [ "$dest" = "refs/heads/pilotage" ] && fail "suppression de la branche pilotage interdite."
    continue   # suppression d'une branche de tâche
  fi
  # main du distant origin, en minuscules : seule forme que garde le ruleset, qui y juge l'avance rapide.
  main=; [ "$remote" = "origin" ] && [ "$remote_ref" = "refs/heads/main" ] && main=1
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    [ -n "$main" ] || git merge-base --is-ancestor "$remote_sha" "$local_sha" ||
      fail "poussée forcée vers $remote_ref interdite (SEC0-13) : l'historique distant serait réécrit."
    range="$remote_sha..$local_sha"
  else
    [ "$remote_sha" = "$ZERO" ] || [ -n "$main" ] ||
      fail "$remote_ref a bougé sur $remote ($remote_sha inconnu ici) : git fetch, puis intégrez sans forcer."
    range="$local_sha --not --remotes=$remote"   # branche nouvelle, ou main inconnue ici : commits absents du distant
  fi
  # --text : un attribut -diff ou binary ne masque pas le contenu ; ni diff externe ni textconv (I3 bis).
  gitleaks_run git --log-opts="--text --no-ext-diff --no-textconv $range" ||
    fail "gitleaks a trouvé un secret probable dans $range (SEC0-08). Il est tenu pour fuité s'il a quitté le poste."
done
exit 0
